# Copy to signing/.env (gitignored). Used by make release-dist and signing-github-secrets.

# Password for signing/developer-id.p12
P12_PASSWORD=

# App Store Connect API key (notarization)
NOTARY_API_KEY_ID=
NOTARY_API_ISSUER_ID=
# Path to AuthKey_XXXXXXXXXX.p8 (place file in signing/)
NOTARY_API_KEY_PATH=

# Optional: Apple ID notarization instead of API key
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
